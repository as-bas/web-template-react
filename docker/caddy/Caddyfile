# Production static host (docker/Dockerfile, target `runtime`). Plain http on
# :80: TLS belongs to whatever sits in front (load balancer, tunnel, proxy).
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Same-origin API, so the refresh cookie needs no credentialed CORS.
	# Unused when the bundle was built with an absolute VITE_API_URL.
	handle /v1/* {
		reverse_proxy {$API_UPSTREAM} {
			header_up Host {upstream_hostport}
			# The API rate limits by X-Real-IP
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Hashed file names: cache forever. Missing ones are a plain 404 (never
	# index.html, never cached), so a CDN can't pin a miss during a deploy.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA: unknown paths render index.html, the router takes over.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
