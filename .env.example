# Compose
# Namespaces containers. Must be unique per repo on this machine. Also names
# the `just deploy-manual` image (<name>:latest) and container (<name>-web).
COMPOSE_PROJECT_NAME=web-template-dev

# Host port the site is served on: dev server (`pnpm dev`, `just app`),
# `just preview` and `just deploy-manual`. Run one of them at a time.
PORT=5173

# The API, where every mode proxies /v1: `pnpm dev`, `just app`,
# `just preview`, `just deploy-manual`. A public URL works everywhere.
# host.containers.internal = the API on this machine (read as localhost by
# `pnpm dev` on the host). With API_NETWORK set to the API's network (its
# COMPOSE_PROJECT_NAME), use http://api:<API PORT> (containers only).
API_UPSTREAM=http://host.containers.internal:3000
# API_NETWORK=api-template

# API base URL baked into the static build. Empty = same origin as the page
# (dev proxy / caddy proxy), recommended. If set to another origin, the API
# must list this site in CORS_ORIGIN (no "*": the refresh cookie needs
# credentials) and both must be the same site for the SameSite cookie.
# Everything in VITE_* is public (it ships in the bundle): no secrets.
VITE_API_URL=

# Obfuscate the production JavaScript (`just preview`, `just deploy-manual`).
# Off by default: about 2x bigger and slower, and it hides nothing secret.
OBFUSCATE=false
